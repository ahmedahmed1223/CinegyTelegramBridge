<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BridgeManager</AssemblyName>
    <RootNamespace>BridgeManager</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Keep the version clean (e.g. "7.49.0") - without this the SDK appends
         a "+<git-hash>" suffix to InformationalVersion/ProductVersion. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- NOT InvariantGlobalization: this is an Arabic-first UI, and invariant
         mode throws on any future culture-aware code (CultureInfo.GetCultureInfo,
         culture-sensitive formatting/compare). The exe is self-contained either way. -->
    <!-- Single self-contained exe: runs on a bare playout box with no .NET install. -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

</Project>
