{
  "name": "cinegy-bridge-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "oxlint src",
    "api:types": "openapi-typescript ../openapi.json -o src/api/schema.d.ts",
    "api:check": "openapi-typescript ../openapi.json -o src/api/schema.d.ts --check"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@mantine/core": "^9.8.1",
    "@mantine/hooks": "^9.8.1",
    "@mantine/modals": "^9.8.1",
    "@mantine/notifications": "^9.8.1",
    "@tabler/icons-react": "^3.52.0",
    "@tanstack/react-query": "^5.108.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.33",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
}
