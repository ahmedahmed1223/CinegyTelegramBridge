  "components": {
    "schemas": {
      "AccountsResponse": {
        "required": [
          "accounts",
          "bridgeUsers"
        ],
        "type": "object",
        "properties": {
          "accounts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WebAccountResponse"
            }
          },
          "bridgeUsers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BridgeUserResponse"
            }
          }
        }
      },
      "BridgeStatus": {
        "required": [
          "version",
          "startedAt",
          "publishedAt",
          "telegram",
          "cinegy",
          "layers"
        ],
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "startedAt": {
            "type": "integer",
            "format": "int64"
          },
          "publishedAt": {
            "type": "integer",
            "format": "int64"
          },
          "telegram": {
            "$ref": "#/components/schemas/TelegramStatus"
          },
          "cinegy": {
            "$ref": "#/components/schemas/CinegyStatus"
          },
          "layers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LayerStatus"
            }
          }
        },
        "nullable": true
      },
      "BridgeUserResponse": {
        "required": [
          "id",
          "name",
          "role",
          "webOnly",
          "username"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "webOnly": {
            "type": "boolean"
          },
          "username": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "ChangePasswordRequest": {
        "required": [
          "currentPassword",
          "newPassword"
        ],
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "type": "string"
          }
        }
      },
      "CinegyStatus": {
        "required": [
          "address",
          "channel",
          "health",
          "lastReadAt",
          "freshUntil"
        ],
        "type": "object",
        "properties": {
          "address": {
            "type": "string"
          },
          "channel": {
            "type": "integer",
            "format": "int32"
          },
          "health": {
            "type": "string"
          },
          "lastReadAt": {
            "type": "integer",
            "format": "int64"
          },
          "freshUntil": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ContentItem": {
        "required": [
          "title",
          "state",
          "rows",
          "id",
          "enabled",
          "values"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "rows": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "id": {
            "type": "string",
            "nullable": true
          },
          "enabled": {
            "type": "boolean",
            "nullable": true
          },
          "values": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "nullable": true
          }
        }
      },
      "ContentPage": {
        "required": [
          "items",
          "page",
          "pageCount",
          "total",
          "revision",
          "fields"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContentItem"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "pageCount": {
            "type": "integer",
            "format": "int32"
          },
          "total": {
            "type": "integer",
            "format": "int32"
          },
          "revision": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TemplateFieldDto"
            },
            "nullable": true
          }
        }
      },
      "CreateAccountRequest": {
        "required": [
          "kind",
          "username",
          "password",
          "displayName",
          "userId",
          "role"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "displayName": {
            "type": "string",
            "nullable": true
          },
          "userId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "role": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "CurrentUser": {
        "required": [
          "id",
          "name",
          "role",
          "method",
          "webOnly"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "webOnly": {
            "type": "boolean"
          }
        },
        "nullable": true
      },
      "ErrorResponse": {
        "required": [
          "error"
        ],
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "default": null,
            "nullable": true
          }
        }
      },
      "LayerStatus": {
        "required": [
          "layer",
          "key",
          "name",
          "at",
          "hideAt",
          "source",
          "by"
        ],
        "type": "object",
        "properties": {
          "layer": {
            "type": "integer",
            "format": "int32"
          },
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "at": {
            "type": "integer",
            "format": "int64"
          },
          "hideAt": {
            "type": "integer",
            "format": "int64"
          },
          "source": {
            "type": "string"
          },
          "by": {
            "type": "string"
          }
        }
      },
      "PasswordSignInRequest": {
        "required": [
          "username",
          "password"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "SessionInfoResponse": {
        "required": [
