# Local, station-specific and private: the live bot token, the operator
# whitelist, and the real template registry with its scene paths. Ship
# the .example.json files instead.
config.json
templates.json
secrets.dpapi.json
*.pre-dpapi.bak

# Runtime output: logs, rotated logs, ffmpeg stderr, snapshots, pid + usage state.
logs/

# Optional local ffmpeg/nssm binaries dropped next to the scripts.
ffmpeg.exe
nssm.exe

# Config safety copies written by Save-Config.
*.bak
*.tmp
*.backups/

# Temporary registries created by the test suite.
templates.test-*.json

# Isolated Codex feature worktrees.
.worktrees/
dist/
artifacts/

# Cygwin/Git-Bash crash dumps.
*.stackdump
